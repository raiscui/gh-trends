# Skip APIs and use mock data
USE_MOCK_REPOS=false

# Clickhouse query settings
SCAN_LIMIT=300
SCAN_WINDOW_DAYS=7
#SCAN_EVAL_DATE=(YYYY-MM-DD)
SCAN_MIN_GROWTH_RATE=0.5
# WHERE 时间轴长度: starsBefore 需要窗口之前的真实历史才能判定"从零爆火"
SCAN_HISTORY_DAYS=60
# 通道 B(从零爆火)绝对门槛与配额, 见 specs/0001 D1
SCAN_CHANNEL_B_MIN_STARS=40
SCAN_CHANNEL_B_LIMIT=100

# Release settings
RELEASE_TOP_N_RUST=30
RELEASE_TOP_N_DEEPSEEK=30
RELEASE_TOP_N_AGENT=30
# Vercel 生态榜取 20 而非 30: 成员收紧后候选 127 个, 有增速数据的仅约 21
# (其中 7 个 28 天零增长)。给 30 会让榜单尾部长期由零增长条目填充。
RELEASE_TOP_N_VERCEL_AI_SDK=20
RELEASE_TOP_N_AI_VIDEO_EDITOR=30
RELEASE_TOP_N=20
RELEASE_TRUNCATE_DESC=0
# 生态榜(Vercel AI SDK / AI Video Editor)的增速排序窗口, 见 docs/adr/0003。
# 28 而非主榜的 7: ClickHouse 对成熟项目只有 0.1%-0.3% 采样
# (实测 vercel/ai 27101 星 / 60 天仅 81 个事件), 7 天窗口对慢增长生态全是噪声。
# 该值同时是 starsWithin 的时间跨度与 starsPerHour 的分母上限, 改一个即可整体生效。
ECOSYSTEM_WINDOW_DAYS=28
# "Past N hours firstSeen" repos 优先排进 top-N;
# daily schedule 下让 release 内容每天都跟昨天不一样。
# 设 0 = 关掉新鲜度优先级,等同原作者全 ranking by score。
SELECT_FRESH_HOURS=24
# 加速度权重(specs/0001 D2): accel = recent/earlier(窗口劈半, clamp [0.5,3]);
# 乘数 = 1 + W*(accel-1), W=0 完全等价旧版纯 starsPerHour 口径
SELECT_ACCEL_WEIGHT=0.5

# 发布去重记忆(specs/0001 D3): 剔除 90 天内已发布过的项目(feed/published.json)
PUBLISHED_MEMORY_ENABLED=true

# Filtering settings
# 40 起: 小众垂直项目在低 star 段也有真实价值, 门槛过高会漏
FILTER_MIN_STARS=40
FILTER_RENAMED=false
FILTER_EMPTY_DESC=false
# 挡盗版钓鱼仓库(KMS-Pico/AutoCad 类, owner 常为随机词组新账号);
# 通道 B(从零爆火)实测高发此类仓库, 是其信噪比的硬依赖
FILTER_FRESH_OWNER=true

# Publish newsletter with Buttondown
BUTTONDOWN_ENABLED=false
BUTTONDOWN_API_KEY=your_buttondown_key_here

# Publish newsletter with Resend
RESEND_ENABLED=false
RESEND_DRAFT=false
RESEND_API_KEY=your_resend_key_here
RESEND_FROM="GitHub Trends <newsletter@your-domain.com>"
#RESEND_REPLY_TO="GitHub Trends <newsletter+unsubscribe@your-domain.com>"
RESEND_AUDIENCE_ID=your_resend_audience_id_here

# Publish to GitHub release
GITHUB_RELEASES_ENABLED=false
GITHUB_RELEASES_REPO=your_gh_username/your_repo_name
GITHUB_TOKEN=your_gh_token_here
# 创建 release 的重试(2026-10-07 事故后加入):
# 当天 GitHub 返回一次 500(响应体为空)就让整天内容全丢, 而 release 是当天
# 唯一产物, 代价不对称。只对 5xx 与网络异常重试, 4xx 不重试。
# 置 1 = 关闭重试; 基准延迟按 2^n 退避, 上限 8s。
RELEASE_CREATE_MAX_ATTEMPTS=3
RELEASE_CREATE_RETRY_BASE_MS=1000
